# ---------------------------------------------------------------- Mapbox ---
# Public token, starts with "pk.". Optional — the app asks for one on first run
# and keeps it in this browser instead. Restrict it to your own URLs in your
# Mapbox account before deploying.
VITE_MAPBOX_TOKEN=

# -------------------------------------------------------------- Supabase ---
# Leave both blank and the app stores everything in localStorage: one browser,
# one machine, nothing shared. Set both and it uses the shared workspace, which
# is what lets the team see each other's plans.
#
# See SETUP-SUPABASE.md. Find both under Settings -> API Keys, or behind the
# "Connect" button at the top of the project dashboard.
#
# The key here must be the PUBLIC one — "sb_publishable_..." on a current
# project, or the legacy "anon" JWT starting "eyJ..." on an older one. Either
# works. Row-level security is what protects the data, which is why a public
# key in the browser is fine.
#
# NEVER put "sb_secret_..." or "service_role" here. Those bypass every policy,
# and anyone who opens the page could read or delete the whole database.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
